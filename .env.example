# Chaves de IA
GEMINI_API_KEY=sua_chave_gemini_aqui
GROQ_API_KEY=sua_chave_groq_aqui

# Configurações do Outlook Corporativo (IMAP com login e senha comum, sem necessidade de admin)
OUTLOOK_EMAIL=seu_email@instituicao.com.br
OUTLOOK_PASSWORD=sua_senha_ou_app_password
OUTLOOK_SERVER=outlook.office365.com
OUTLOOK_PORT=993
OUTLOOK_FOLDER=INBOX

# Limite de certificados (0 = sem limite)
MAX_CERTIFICATES=0
